---
// Find us: an illustrated map of Cluster D (not to scale), then the address, hours and ways to reach
// Betawi. Every link and number comes from restaurant.json. The map colours are tokens (--map-*), so
// it follows night mode. The storefront photo lives in the gallery.
import restaurant from '../content/restaurant.json';
import Icon from './Icon.astro';

const { address, hours, phone, phoneDisplay, mapsUrl, whatsapp, instagram, tableOrder } = restaurant;
const mapLabel = `Illustrated map, not to scale: ${address.oneLine}, ${address.landmark.toLowerCase()}, by the lake. Opens Google Maps.`;
---

<section id="find-us" class="find" aria-labelledby="find-title">
  <div class="find-in pad">
    <h2 id="find-title" class="headline"><span class="mk"><span>Find us in Cluster D, JLT.</span></span></h2>

    <div class="layout">
      <div class="mapcard reveal">
        <a class="maplink" href={mapsUrl} target="_blank" rel="noopener" aria-label={mapLabel}>
          <svg viewBox="130 60 380 330" role="img" aria-label={`Map: ${address.oneLine}, ${address.landmark.toLowerCase()}. Not to scale.`}>
            <rect x="130" y="60" width="380" height="330" fill="var(--map-bg)" />
            <!-- the lake -->
            <path d="M 210 0 L 620 0 L 620 190 Q 510 175, 420 140 T 255 68 Q 225 40, 210 0 Z" fill="var(--map-water)" />
            <path d="M 225 0 Q 245 45, 275 68 T 435 136 Q 525 168, 620 182" fill="none" stroke="var(--map-water-edge)" stroke-width="3" opacity="0.65" />
            <path d="M 350 42 Q 385 34, 420 42 T 490 42" fill="none" stroke="#52B788" stroke-width="1.3" opacity="0.4" />
            <path d="M 430 96 Q 465 88, 500 96 T 570 96" fill="none" stroke="#52B788" stroke-width="1.3" opacity="0.35" />
            <text x="420" y="82" text-anchor="middle" class="t-lake">Almas East Lake</text>
            <!-- blocks and roads -->
            <polygon points="0,0 185,0 155,105 0,75" fill="var(--map-block)" opacity="0.6" />
            <polygon points="0,105 145,135 110,245 0,215" fill="var(--map-block)" opacity="0.6" />
            <polygon points="485,220 620,245 620,355 455,315" fill="var(--map-block)" opacity="0.6" />
            <path d="M -20 95 L 590 235" stroke="var(--map-road)" stroke-width="24" stroke-linecap="round" />
            <path d="M 175 -15 L 85 310" stroke="var(--map-road)" stroke-width="20" stroke-linecap="round" />
            <path d="M 465 165 L 395 420" stroke="var(--map-road)" stroke-width="18" stroke-linecap="round" />
            <path d="M -20 265 L 640 415" stroke="var(--map-road)" stroke-width="34" />
            <path d="M -20 318 L 640 468" stroke="var(--map-road)" stroke-width="42" />
            <path d="M -20 292 L 640 442" stroke="var(--clay)" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.45" />
            <!-- footbridge from the metro -->
            <path d="M 412 362 L 325 245" stroke="var(--turmeric)" stroke-width="4" stroke-dasharray="5 4" />
            <!-- neighbouring towers -->
            <polygon points="158,132 232,150 212,222 138,204" fill="var(--map-block)" stroke="var(--clay)" stroke-opacity="0.35" stroke-width="1.2" />
            <text x="175" y="184" text-anchor="middle" class="t-tower">Indigo Tower</text>
            <polygon points="348,178 424,196 404,268 328,250" fill="var(--map-block)" stroke="var(--clay)" stroke-opacity="0.35" stroke-width="1.2" />
            <text x="372" y="230" text-anchor="middle" class="t-tower">Lake City Tower</text>
            <!-- Lake Terrace Tower -->
            <polygon points="254,142 334,162 312,244 232,224" fill="var(--map-plot)" stroke="var(--clay)" stroke-width="2.2" />
            <circle cx="272" cy="140" r="4" fill="var(--green-text)" stroke="var(--paper)" stroke-width="1" />
            <circle cx="294" cy="145" r="4" fill="var(--green-text)" stroke="var(--paper)" stroke-width="1" />
            <circle cx="316" cy="151" r="4" fill="var(--green-text)" stroke="var(--paper)" stroke-width="1" />
            <text transform="translate(150 118) rotate(13)" class="t-road">Cluster D</text>
            <text transform="translate(150 300) rotate(13)" class="t-road">Sheikh Zayed Rd</text>
            <!-- pin -->
            <circle cx="286" cy="192" r="18" class="pulse" />
            <g transform="translate(206 92)">
              <rect width="170" height="32" rx="16" class="pill" />
              <text x="85" y="21" text-anchor="middle" class="t-pill">Lake Terrace Tower</text>
            </g>
            <g transform="translate(286 192)">
              <path d="M 0 0 C -11 -14, -18 -24, -18 -34 A 18 18 0 1 1 18 -34 C 18 -24, 11 -14, 0 0 Z" fill="var(--clay-solid)" stroke="var(--light-paper)" stroke-width="2.5" />
              <circle cx="0" cy="-34" r="6.5" fill="var(--light-paper)" />
            </g>
            <!-- metro -->
            <g transform="translate(356 326)">
              <rect width="142" height="30" rx="15" class="pill" />
              <text x="71" y="20" text-anchor="middle" class="t-pill">DMCC Metro</text>
              <circle cx="71" cy="52" r="15" fill="var(--ink)" />
              <text x="71" y="57" text-anchor="middle" class="t-m">M</text>
            </g>
          </svg>
          <span class="openmaps"><Icon name="pin" size={18} />Open in Maps</span>
        </a>
        <p class="scale">Not to scale.</p>
      </div>

      <div class="details">
        <div class="item">
          <Icon name="pin" size={24} />
          <div>
            <h3>Address</h3>
            <p>{address.oneLine}</p>
            <p class="small">{address.landmark}</p>
            <a class="textlink" href={mapsUrl} target="_blank" rel="noopener">Get directions</a>
          </div>
        </div>
        <div class="item">
          <svg class="ic" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.500 2" /></svg>
          <div>
            <h3>Hours</h3>
            <p>{hours.display}</p>
          </div>
        </div>
        <div class="item">
          <Icon name="phone" size={24} />
          <div>
            <h3>Contact</h3>
            <a class="phone" href={`tel:${phone}`}>{phoneDisplay}</a>
            <p class="small">Call, or message us on WhatsApp.</p>
            <div class="circles">
              {whatsapp && <a class="circle" href={`https://wa.me/${whatsapp}`} rel="noopener" aria-label="Message Betawi on WhatsApp"><Icon name="whatsapp" size={20} /></a>}
              <a class="circle" href={instagram.url} rel="noopener" aria-label={`Betawi on Instagram, ${instagram.handle}`}><Icon name="instagram" size={20} /></a>
              <a class="circle" href={mapsUrl} target="_blank" rel="noopener" aria-label="Directions in Google Maps"><Icon name="pin" size={20} /></a>
            </div>
          </div>
        </div>
        <div class="cta">
          {tableOrder && <a class="textlink" href={tableOrder.url} target="_blank" rel="noopener">{tableOrder.label}</a>}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .find { position: relative; margin-top: 0; padding: 80px 0 24px; }
  .find-in { max-width: 1200px; margin-inline: auto; padding-inline: var(--gutter); }
  .headline { max-width: 15ch; font-size: clamp(2.25rem, 1.5rem + 3.2vw, 3.75rem); margin-bottom: 28px; }
  .layout { display: grid; gap: 32px; }
  .mapcard { display: grid; gap: 8px; }
  .maplink { position: relative; display: block; overflow: clip; border: 1px solid var(--rule-c, color-mix(in srgb, var(--clay) 40%, transparent)); border-radius: var(--radius); color: inherit; text-decoration: none; }
  svg:not(.ic) { display: block; width: 100%; height: auto; }
  .t-lake { font: italic 400 17px var(--font-display); fill: var(--light); }
  .t-tower { font: 600 13px var(--font-sans); fill: var(--muted); }
  .t-road { font: 600 13px var(--font-sans); fill: var(--muted); }
  .t-pill { font: 700 14px var(--font-sans); fill: var(--ink); }
  .t-m { font: 700 15px var(--font-sans); fill: var(--sand); }
  .pill { fill: var(--paper); stroke: var(--clay); stroke-opacity: 0.4; stroke-width: 1.2; }
  .pulse { fill: var(--clay-solid); fill-opacity: 0.3; transform-origin: 286px 192px; }
  @media (prefers-reduced-motion: no-preference) { .pulse { animation: ring 2.8s var(--ease-lux) infinite; } }
  @keyframes ring { 0% { transform: scale(0.85); opacity: 0.9; } 70%, 100% { transform: scale(1.8); opacity: 0; } }
  .openmaps { position: absolute; left: 14px; bottom: 14px; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; background: var(--clay-solid); color: var(--light-paper); font: 600 0.9375rem/1 var(--font-sans); border-radius: var(--radius); }
  .scale { font-size: 0.875rem; color: var(--muted); }

  .details { display: grid; gap: 24px; align-content: start; }
  .item { display: grid; grid-template-columns: 28px 1fr; gap: 14px; align-items: start; color: var(--clay); }
  .item > :global(.ic) { margin-top: 2px; }
  .item > div { color: var(--ink); }
  h3 { font: 700 1.0625rem/1.3 var(--font-sans); margin-bottom: 2px; }
  .item p { font-size: 1.0625rem; }
  .small { font-size: 0.9375rem; color: var(--muted); }
  .item .textlink { display: inline-flex; align-items: center; min-height: 44px; }
  .phone { display: inline-flex; align-items: center; min-height: 44px; font: 600 1.1875rem/1.3 var(--font-sans); color: var(--ink); text-decoration: none; }
  .circles { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
  .circle { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1px solid color-mix(in srgb, var(--clay) 45%, transparent); border-radius: 50%; color: var(--ink); text-decoration: none; transition: transform 0.45s var(--ease); }
  @media (hover: hover) { .circle:hover { background: var(--clay-solid); border-color: var(--clay-solid); color: var(--light-paper); transform: translateY(-2px); } }
  .cta { display: grid; gap: 4px; justify-items: start; padding-top: 4px; }

  @media (min-width: 768px) {
    .find { padding: 112px 0 32px; }
    .find-in { padding-inline: 48px; }
  }
  @media (min-width: 900px) {
    .layout { grid-template-columns: 1.28fr 0.92fr; gap: 56px; align-items: center; }
  }
</style>
