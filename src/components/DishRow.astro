---
// One dish in a list. The whole row is a link to the dish's own page (/menu/<id>/). The photo
// touches the row edge so the plank grain runs down the list. No photo: a text-only row, never a
// stand-in. `transition` gives the photo a view-transition name so it carries over to the dish
// page; leave it off where the same dish could appear twice on one page.
import { Image } from 'astro:assets';
import { dishPhoto, aed, type Dish } from '../lib/menu';

interface Props { dish: Dish; transition?: boolean }
const { dish, transition = true } = Astro.props;
const photo = dishPhoto(dish.photo);
const vegan = dish.tags.includes('vegan');
const spicy = dish.tags.includes('spicy');
---

<li class="row" data-vegan={vegan ? '' : undefined} data-spicy={spicy ? '' : undefined}>
  <a href={`/menu/${dish.id}/`} class="link">
    {photo && (
      <Image
        src={photo}
        alt=""
        width={176}
        height={176}
        densities={[1, 2, 3]}
        loading="lazy"
        class="thumb"
        style={transition ? `view-transition-name: dish-${dish.id}` : undefined}
      />
    )}
    <div class="text">
      <div class="line">
        <h3>{dish.name}</h3>
        {dish.price === null ? <span class="price none">Price to confirm</span> : <span class="price">{aed(dish.price)}</span>}
      </div>
      {dish.desc && <p class="desc">{dish.desc}</p>}
      {(spicy || vegan || dish.pick) && (
        <p class="tags">
          {spicy && <span class="tag spicy">Spicy</span>}
          {vegan && <span class="tag vegan">Vegan</span>}
          {dish.pick && <span class="tag pick">Review pick</span>}
        </p>
      )}
    </div>
  </a>
</li>

<style>
  .row { display: flex; position: relative; }
  .row::after { content: ''; position: absolute; left: var(--gutter); right: var(--gutter); bottom: 0; height: 1px; background: color-mix(in srgb, var(--clay) 40%, transparent); transform-origin: 0 50%; }
  .link { flex: 1; display: grid; grid-template-columns: 128px 1fr; gap: 18px; align-items: start; padding: 16px var(--gutter); text-decoration: none; color: inherit; }
  .row:not(:has(.thumb)) .link { grid-template-columns: 1fr; }
  @media (hover: hover) { .link:hover { background: var(--paper); } }
  .link:focus-visible { background: var(--paper); }
  .thumb { display: block; width: 128px; height: 128px; object-fit: cover; }
  .text { min-width: 0; }
  .line { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; column-gap: 12px; }
  .line h3 { min-width: 0; }
  h3 { font: 600 1.25rem/1.2 var(--font-display); }
  .price.none { color: var(--muted); font-size: 0.875rem; font-weight: 600; white-space: normal; text-align: right; }
  .desc { color: var(--muted); margin-top: 4px; font-size: 0.9375rem; line-height: 1.45; }
  .tags { display: flex; flex-wrap: wrap; gap: 2px 14px; margin-top: 4px; }
  .tag { font: 600 0.875rem/1.5 var(--font-sans); }
  .tag.spicy { color: var(--clay); }
  .tag.vegan, .tag.pick { color: var(--green-text); }
  @media (min-width: 720px) {
    .link { grid-template-columns: 176px 1fr; gap: 24px; padding-block: 20px; }
    .row:not(:has(.thumb)) .link { grid-template-columns: 1fr; }
    .thumb { width: 176px; height: 176px; }
  }
</style>
