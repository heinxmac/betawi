---
// A small line-icon set, drawn once: 1.5 stroke, round caps. Decorative: the words carry the meaning.
interface Props { name: 'arrow-right' | 'phone' | 'whatsapp' | 'pin' | 'instagram'; size?: number }
const { name, size = 20 } = Astro.props;
const paths: Record<string, string> = {
  'arrow-right': '<path d="M4 12h15M13 6l6 6-6 6"/>',
  phone: '<path d="M6 4h3l2 5-2.4 1.5a11 11 0 0 0 4.900 4.900L15 13l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 4 6a2 2 0 0 1 2-2z"/>',
  whatsapp: '<path d="M4 20l1.300-4A8 8 0 1 1 8 18.700L4 20z"/><path d="M9.200 8.800c.4 2.300 2.700 4.600 5.800 5.600l1.200-1.300-2.100-1-1 .9c-.9-.4-1.800-1.300-2.200-2.200l.9-1-1-2.100-1.600 1.100z"/>',
  instagram: '<rect x="4" y="4" width="16" height="16" rx="4.500"/><circle cx="12" cy="12" r="3.600"/><circle cx="16.800" cy="7.200" r="0.700" fill="currentColor"/>',
  pin: '<path d="M12 21s7-6.200 7-11.500a7 7 0 1 0-14 0C5 14.800 12 21 12 21z"/><circle cx="12" cy="9.500" r="2.500"/>',
};
---
<svg class="ic" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={paths[name]} />
