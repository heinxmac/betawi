---
// Header. Phone: real logo square and the text link "Call". Desktop (720px and up): logo, three
// links, and a Book button that appears once the hero's own Book button has scrolled away.
import { Image } from 'astro:assets';
import logo from '../assets/logo/betawi-logo-wide.png';
import restaurant from '../content/restaurant.json';
import Icon from './Icon.astro';
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label="Betawi, home">
      <Image src={logo} alt="Betawi, Taste of Indonesia" width={145} height={64} densities={[1, 2]} loading="eager" />
    </a>
    <nav class="links" aria-label="Main">
      <a class="textlink" href="/menu/">Menu</a>
      <a class="textlink" href="/#story">Our story</a>
      <a class="textlink" href="/#find-us">Find us</a>
    </nav>
    <a class="btn btn-primary header-book" href="#book" data-book>Book a table</a>
    <div class="quick">
      <a class="textlink" href={`tel:${restaurant.phone}`}><Icon name="phone" size={18} /><span class="lbl">Call</span></a>
      <a class="textlink" href={restaurant.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" size={18} /><span class="lbl">Directions</span></a>
    </div>
    <button type="button" class="theme" data-theme-toggle aria-pressed="false">
      <span class="moon"><Icon name="moon" size={20} /></span><span class="sun"><Icon name="sun" size={20} /></span><span class="tl">Night mode</span>
    </button>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: var(--sand); border-bottom: 1px solid color-mix(in srgb, var(--clay) 22%, transparent); }
  .inner { display: flex; align-items: center; justify-content: space-between; max-width: 1200px; margin-inline: auto; padding-right: var(--gutter); }
  .brand { display: block; line-height: 0; }
  .brand :global(img) { width: auto; height: 64px; }
  .quick { display: flex; align-items: center; gap: 4px 18px; }
  .quick a { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; min-width: 44px; white-space: nowrap; }
  .theme { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 44px; min-height: 44px; padding: 0; border: 0; background: none; color: var(--ink); font: 600 0.9375rem/1 var(--font-sans); cursor: pointer; }
  .theme .sun, :global(html[data-theme='night']) .theme .moon { display: none; }
  :global(html[data-theme='night']) .theme .sun { display: inline-flex; }
  .theme .moon { display: inline-flex; }
  .theme .tl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 389px) { .quick .lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; } }
  .links, .header-book { display: none; }

  @media (min-width: 720px) {
    .inner { padding-inline: 48px; gap: 32px; justify-content: flex-start; }
    .links { display: flex; gap: 28px; margin-left: auto; }
    .quick { display: none; }
    .theme { padding: 0 4px; }
    .links a, .header-book { white-space: nowrap; }
    .inner { gap: 20px; }
    .header-book {
      display: flex;
      min-height: 44px;
      padding: 0 20px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transition: opacity 0.6s var(--ease), transform 0.6s var(--ease), visibility 0.6s;
    }
    :global(html[data-actions-away]) .header-book { opacity: 1; visibility: visible; transform: none; }
  }
  @media (min-width: 1000px) {
    .inner { gap: 32px; }
    .theme .tl { position: static; width: auto; height: auto; clip-path: none; overflow: visible; }
  }
  @media (prefers-reduced-motion: reduce) {
    .header-book { transform: none !important; transition: none !important; }
  }
</style>

<script>
  // Night mode switch: saves the choice, keeps the pill and the browser colour in step.
  const root = document.documentElement;
  const pill = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const bar = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const sync = () => {
    const night = root.getAttribute('data-theme') === 'night';
    pill?.setAttribute('aria-pressed', String(night));
    if (bar) bar.content = night ? '#14221D' : '#EFE4CC';
  };
  sync();
  pill?.addEventListener('click', () => {
    const night = root.getAttribute('data-theme') !== 'night';
    if (night) root.setAttribute('data-theme', 'night'); else root.removeAttribute('data-theme');
    try { localStorage.setItem('betawi-theme', night ? 'night' : 'day'); } catch { /* storage blocked: the choice lasts for this visit */ }
    sync();
  });
</script>
