# Cloudflare Pages applies these rules to every response. (Local preview ignores this file.)

# Files whose names contain a fingerprint (like mohinga.C1x2y3z4.webp) never change,
# so a visitor's phone can keep them for a year: repeat visits are instant.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Basic safety headers for every page.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
